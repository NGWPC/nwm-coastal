# =============================================================================
# ecflow 5.6.0 suite: coastal_hourly
#
# Hourly demo pipeline: nwm-rte forcing + VPU 03S regionalization (t-route)
# -> per-cycle SCHISM/SFINCS run.yaml generation -> SCHISM + SFINCS runs.
#
# Each hour of the day is a permanent, individually-inspectable/rerunnable
# family (h00..h23), gated by its own `time HH:00`. The enclosing `repeat
# date YMD` auto-increments (and auto-requeues all 24 children) once every
# hNN family for the day has completed -- see `ecflow_client --help force`.
#
# Load / start with server/load_and_begin.sh:
#   ecflow_client --load=coastal_hourly.def check_only   # syntax-check first
#   ecflow_client --load=coastal_hourly.def
#   ecflow_client --begin=coastal_hourly
# =============================================================================

suite coastal_hourly

  # ---- ecFlow bookkeeping ----
  edit ECF_HOME    '${NWM_COASTAL_ROOT}/forecast_demo/ecf_home'
  edit ECF_FILES   '${NWM_COASTAL_ROOT}/forecast_demo/ecf_home'
  edit ECF_INCLUDE '${NWM_COASTAL_ROOT}/forecast_demo/ecf_home'
  edit ECF_TRIES   '1'

  # ---- Pipeline paths (single source of truth for all tasks) ----
  edit NWM_RTE_DIR           '${NWM_RTE_ROOT}'
  # nwm-rte's config.bashrc now defaults EWTS_ENABLED to YES, but several
  # of its sub-modules (FCSTMGR, MSWMGR) write their own log files straight
  # into RUN_NGEN_ROOT's regionalization dir even at the default INFO
  # level -- confirmed live, and since that mount is NFS-backed, this is
  # the same class of problem PMIX_MCA_gds=hash was removed for elsewhere
  # (nwm-rte/run.sh): lots of small file writes to an NFS mount, real
  # slowdown during troute runs. Override back to NO here, for this
  # pipeline only -- see ngen_forcing_ana.ecf/ngen_forcing_sr.ecf/
  # troute_ana_a.ecf/troute_ana_b.ecf/troute_sr.ecf, the only tasks that
  # source config.bashrc.
  edit EWTS_ENABLED          'NO'
  # Single source of truth for which VPU this suite targets -- used for the
  # -v flag on all troute_*.ecf scripts, TEST_VPU, and the troute output
  # path (see troute_sr.ecf/troute_ana_a.ecf/troute_ana_b.ecf/gen_configs_sr.ecf/gen_configs_ana.ecf).
  # Change this and everything downstream follows automatically. Note: the
  # SCHISM/SFINCS prebuilt models
  # (SCHISM_BASE_YAML/SFINCS_BASE_YAML below) are geography-specific to
  # VPU 03S (Tampa Bay) and are NOT re-derived from this -- swapping VPU
  # without also swapping those base configs would mismatch the coastal
  # domain from the hydrology domain.
  edit VPU                   '03S'
  edit FORCING_OUT_DIR       '${RUN_NGEN_ROOT}/data/scratch/short_range_coastal'
  # ngen_forcing_ana.ecf's output dir -- run_coastal.py's own output path
  # convention already segregates by forcing_configuration
  # (FORCING_ROOT_DIR/scratch/<forcing_configuration>_coastal/), confirmed
  # by reading run_coastal.py directly, so this is a real, distinct path,
  # not a guess.
  edit FORCING_OUT_DIR_ANA   '${RUN_NGEN_ROOT}/data/scratch/standard_ana_coastal'
  # Shared regionalization root (data/raw_input etc. stay shared too, on
  # purpose -- see ngen_troute.ecf). Cycle+VPU isolation comes from -rname
  # being cycle-specific, not from a separate root: this resolves to
  # TROUTE_REGIONALIZATION_ROOT/region_sr_<cycle>/<VPU>/troute_output_*.nc.
  edit TROUTE_REGIONALIZATION_ROOT '${RUN_NGEN_ROOT}/regionalization'
  # Container-side view of the same directory as TROUTE_REGIONALIZATION_ROOT
  # above (nwm-rte's docker_run mounts MNT__RUN_NGEN__HOST at
  # MNT__RUN_NGEN__CONTAINER=/ngwpc/run_ngen -- confirmed live). Required
  # specifically for -ssd/-lsf: those flags are consumed by the
  # run_regionalization_standalone.py process INSIDE the container, so
  # passing them the HOST path (TROUTE_REGIONALIZATION_ROOT) resolves to a
  # path that doesn't exist in the container's filesystem -- confirmed
  # live, this silently no-ops the save (ngen logs "Saving end of run
  # simulation data..." for every rank, but no file is ever written).
  # TROUTE_REGIONALIZATION_ROOT itself stays host-side on purpose: the
  # .ecf scripts' own existence checks ([ -f ... ]) run outside docker, on
  # the host, where only that path resolves.
  edit TROUTE_REGIONALIZATION_ROOT_CONTAINER '/ngwpc/run_ngen/regionalization'
  edit NWM_COASTAL_CLI       '${NWM_COASTAL_ROOT}/nwm-coastal-cli'
  edit NWM_COASTAL_PY        '${NWM_COASTAL_ROOT}/nwm-coastal-py'
  edit GEN_SCRIPT            '${NWM_COASTAL_ROOT}/forecast_demo/bin/gen_cycle_config.py'
  edit SCHISM_BASE_YAML       '${RUN_COASTAL_ROOT}/schism_sims/run.yaml'
  edit SFINCS_BASE_YAML       '${RUN_COASTAL_ROOT}/sfincs_sims/run.yaml'
  # Everything ecflow generates (per-cycle configs + work dirs) lives under
  # run_coastal/, nested next to the base templates and the S3-staged
  # prebuilt models -- nothing generated ever lands inside the nwm-coastal
  # repo checkout itself.
  edit SCHISM_CYCLES_DIR      '${RUN_COASTAL_ROOT}/schism_sims/cycles'
  edit SFINCS_CYCLES_DIR      '${RUN_COASTAL_ROOT}/sfincs_sims/cycles'

  family cycle
    # Day-rollover odometer. Per `ecflow_client --help force`: "A repeat
    # attribute is incremented when all the child nodes are complete" --
    # once the last hNN family of the day completes, YMD increments and
    # h00..h23 auto-requeue for the new date.
    # ${TODAY_YMD} is substituted by load_and_begin.sh at every load,
    # computed fresh from the real current UTC date -- NOT a fixed literal.
    # This matters because a `--load force` (which load_and_begin.sh always
    # does, so it's safely re-runnable -- see its own comments) replaces the
    # whole suite, resetting this repeat to whatever start bound is baked
    # into the def at that moment. A stale hardcoded date here silently
    # desyncs every .ecf script's own YMD/CYCLE_DT (used for real data
    # lookups) from the suite's calendar (which correctly tracks real time
    # regardless) -- every date-dependent task then looks for data from
    # whatever day was last hardcoded here instead of today.
    repeat date YMD ${TODAY_YMD} 20991231 1

