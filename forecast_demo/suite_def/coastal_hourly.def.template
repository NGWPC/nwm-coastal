      task troute_ana_b
        trigger ../h23/troute_ana_a == complete
      task troute_sr
        trigger troute_ana_b == complete
      task gen_configs_ana
        trigger troute_ana_b == complete and ngen_forcing_ana == complete
      task run_stofs_download_ana
        trigger gen_configs_ana == complete
      task schism_ana
        trigger run_stofs_download_ana == complete and ../h23/schism_ana == complete
      task sfincs_ana
        trigger run_stofs_download_ana == complete and ../h23/sfincs_ana == complete
      task gen_configs_sr
        trigger ngen_forcing_sr == complete and troute_sr == complete and schism_ana == complete and sfincs_ana == complete
      task run_stofs_download_sr
        trigger gen_configs_sr == complete
      task schism_sr
        trigger run_stofs_download_sr == complete
      task sfincs_sr
        trigger run_stofs_download_sr == complete
    endfamily
