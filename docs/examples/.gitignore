# Shared NWM/STOFS download cache (~83 GB; never commit)
downloads/

# Per-domain runtime working dirs
**/cache/
**/run/
**/run_*/
**/output/
**/output_*/
**/extracted/
**/model_a/
**/model_b/
**/figs/
**/sfincs_model/

# Per-domain symlinks to proprietary data (set up post-clone — see README)
**/model
**/geo_em_*.nc

# SFINCS files written into working dirs. The model directory can be named
# anything (create.yaml's output_dir), so match the file names, not the folder.
**/sfincs*.nc
**/sfincs*.inp
**/sfincs*.bnd
**/sfincs*.bzs
**/sfincs*.obs
**/sfincs*.src
**/*.dis
**/*_subgrid.nc

# Status/manifest files written by `coastal-calibration create`
**/create_progress.json
**/create_result.json
**/obs_station_map.json

# Other transient artifacts
*.log
*.tif
*.tiff
*.qmd
gis/
subgrid/
.create_status.json
.pipeline_status.json
workflow_*.json
slurm-*.out
.DS_Store
