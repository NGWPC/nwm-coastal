      task gen_configs
        trigger ngen_forcing == complete and ngen_troute == complete
      task run_schism_download
        trigger gen_configs == complete
      task run_schism
        trigger run_schism_download == complete
      task run_sfincs
        trigger run_schism_download == complete
    endfamily
    family h10
      edit HOUR '10'
      time 10:00
      task ngen_forcing
      task ngen_troute
      task gen_configs
        trigger ngen_forcing == complete and ngen_troute == complete
      task run_schism_download
        trigger gen_configs == complete
      task run_schism
        trigger run_schism_download == complete
      task run_sfincs
        trigger run_schism_download == complete
    endfamily
    family h11
