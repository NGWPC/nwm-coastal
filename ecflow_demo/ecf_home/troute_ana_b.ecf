%include <head.h>

YMD=%YMD%
HH=%HOUR%
CYCLE=${YMD}${HH}
CYCLE_DT="${YMD:0:4}-${YMD:4:2}-${YMD:6:2} ${HH}:00:00"

# troute AnA-B: the 3-hour (T-3 -> T0 relative to this cycle's own time). 
# Never chained forward to a future AnA cycle (that's troute_ana_a's job)
# - this run exists to produce a T0 state for THIS cycle's SR troute run 
# (troute_sr.ecf) and coastal AnA cycles to use for forcing.
# Loads from the SAME prior-cycle troute_ana_a save that troute_ana_a.ecf 
# loads from (both branch off the same T-3 starting point) 
# 
# note: the -1 relative adjustment must come BEFORE the timestamp as
# "${CYCLE_DT} -1 hour" silently parses wrong in GNU date.

PREV_DT="-1 hour ${CYCLE_DT}"
PREV_CYCLE=$(date -u -d "${PREV_DT}" +"%%Y%%m%%d%%H")

# troute names its output file after the run's actual start_time, not the
# cycle time. This run's fcst_start is T-3 (CYCLE_DT-3h): -dt is CYCLE_DT (T0)
# and -lb 240 pulls it back to T-3 -- mswm's create_fcst_times() (ana_flag==1
# branch) computes forcing_lookback = int(LookBack/60) - 1, so -lb 240 resolves 
# to a 3h lookback (int(240/60)-1 == 3). But troute's own restart/output timestamp is a
# further 1h before fcst_start by design (mswm ginputfunc.py: "troute must
# start 1h before [ngen] so that states can be transferred between runs",
# for realtime/non-hindcast forcing) so the real stamp is T-4, not T-3.

STAMP=$(date -u -d "-4 hours ${CYCLE_DT}" +"%%Y%%m%%d%%H")00

RNAME="region_ana_b_${CYCLE}"

# netCDF outputs (troute_output_*.nc etc.) land in an Output/ subdirectory
# for AnA runs

TROUTE_OUT_FILE="%TROUTE_REGIONALIZATION_ROOT%/${RNAME}/%VPU%/Output/troute_output_${STAMP}.nc"

# HOST-side paths -- for the [ -f ... ] existence checks (outside docker).

SAVE_STATE_DIR="%TROUTE_REGIONALIZATION_ROOT%/${RNAME}/%VPU%/state_save"
LOAD_STATE_DIR="%TROUTE_REGIONALIZATION_ROOT%/region_ana_a_${PREV_CYCLE}/%VPU%/state_save"

# CONTAINER-side paths -- for the -ssd/-lsf flags, read INSIDE the
# container. See troute_ana_a.ecf for why these must differ from the HOST
# paths above.

SAVE_STATE_DIR_CONTAINER="%TROUTE_REGIONALIZATION_ROOT_CONTAINER%/${RNAME}/%VPU%/state_save"
LOAD_STATE_DIR_CONTAINER="%TROUTE_REGIONALIZATION_ROOT_CONTAINER%/region_ana_a_${PREV_CYCLE}/%VPU%/state_save"

export CYCLE_DT
export RNAME

# Bootstrap handling: see troute_ana_a.ecf - same source state
# (both A and B load from the same prior-cycle troute_ana_a save).

if [ -f "${LOAD_STATE_DIR}/troute" ]; then
  LOAD_STATE_ARGS="-lsf ${LOAD_STATE_DIR_CONTAINER}"
  echo "Warm-starting troute AnA-B from ${LOAD_STATE_DIR}"
else
  LOAD_STATE_ARGS=""
  echo "No prior troute_ana_a state at ${LOAD_STATE_DIR} -- cold-starting (expected only at bootstrap)"
fi
export LOAD_STATE_ARGS
export SAVE_STATE_DIR_CONTAINER

# ---- LAUNCH (placeholder for future Slurm submission) --------------------
# Today: direct execution on this shared node. 
bash -c '
  set -euo pipefail
  cd "%NWM_RTE_DIR%"
  export EWTS_ENABLED="%EWTS_ENABLED%"
  # TEMPORARY: pinned to a locally built image with the Aug 5 fix
  # (commit 2bb8004, "when type is gridded, does not delete the esmf
  # mesh") -- ngen_rte_ghcr:latest and ngen_rte_build_from_local:latest
  # were both confirmed missing that fix as of 2026-08-20. Revert to
  # the config.bashrc default (remove this line) once a corrected
  # image is promoted back to ngen_rte_ghcr:latest. No apostrophes in
  # this comment -- it lives inside a single-quoted bash -c block.
  export TARGET_IMAGE_NAME="ngen_rte_lauren_20260820"
  source config.bashrc
  source run.sh
  TEST_VPU="vpu_%VPU%"
  TEST_FORM_ASSIGN_VPU="${INSTALLED_REGIONALIZATION_RESULTS}/${TEST_VPU}/formulation_assignment.csv"
  TEST_CAT_GRP_VPU="${INSTALLED_REGIONALIZATION_RESULTS}/${TEST_VPU}/catchment_groups.csv"
  docker_run python -um "ngen_rte.run_regionalization_standalone" -n 12 -faf "${TEST_FORM_ASSIGN_VPU}" -cgf "${TEST_CAT_GRP_VPU}" -fconfig "standard_ana" -dt "${CYCLE_DT}" -lb 240 -rname "${RNAME}" -v "%VPU%" -outfmt NetCDF -ss -ssd "${SAVE_STATE_DIR_CONTAINER}" ${LOAD_STATE_ARGS}
' "%NWM_RTE_DIR%/run.sh"
# ---- END LAUNCH ------------------------------------------------------------

if [ ! -f "${TROUTE_OUT_FILE}" ]; then
  echo "ERROR: expected t-route output missing: ${TROUTE_OUT_FILE}" >&2
  exit 1
fi
if [ ! -f "${SAVE_STATE_DIR}/troute" ]; then
  echo "ERROR: expected troute_ana_b state save missing: ${SAVE_STATE_DIR}/troute" >&2
  exit 1
fi
echo "troute AnA-B OK: ${TROUTE_OUT_FILE}, ${SAVE_STATE_DIR}/troute"

%include <tail.h>
