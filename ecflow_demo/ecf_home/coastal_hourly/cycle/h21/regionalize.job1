set -e -u -x   # abort on error/unset var, print commands as executed

# Variables ecFlow substitutes at job-generation time (ecflow 5.6.0)
export ECF_NAME=/coastal_hourly/cycle/h21/regionalize
export ECF_HOST=zhengtaocui-opertestbed-00023-mgmt
export ECF_PORT=39411
export ECF_PASS=6hpH4Jdc
export ECF_TRYNO=1
export ECF_RID=$$              # no batch scheduler wrapping this job -> use the shell PID

export PATH="/contrib/software/ecflow/5.6.0/bin:${PATH}"

# Tell ecFlow this task has started
ecflow_client --init="${ECF_RID}"

# Error handler: report --abort to ecFlow instead of leaving the task
# stuck 'active' forever. Guarded against double-firing (ERR then EXIT).
_ERROR_HANDLED=0
ERROR() {
  local rc=$1
  set +e
  if [ "${_ERROR_HANDLED}" -eq 1 ]; then
    exit "${rc}"
  fi
  _ERROR_HANDLED=1
  trap - ERR EXIT
  ecflow_client --abort="task failed (rc=${rc})" || true
  exit "${rc}"
}
trap 'ERROR $?' ERR
trap 'ERROR $?' EXIT

YMD=20260805
HH=21
CYCLE=${YMD}${HH}
CYCLE_DT="${YMD:0:4}-${YMD:4:2}-${YMD:6:2} ${HH}:00:00"
STAMP=${CYCLE}00

TROUTE_OUT_FILE="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/region_sr/03S/troute_output_${STAMP}.nc"

cd "/contrib/LaurenSchambach/ngwpc/nwm-rte"
export CYCLE_DT

# ---- LAUNCH (placeholder for future Slurm submission) --------------------
# Today: direct execution on this shared node.
# Future migration, e.g.:
#   sbatch --wait --job-name="coastal_regionalize_${CYCLE}" \
#     --output="/contrib/LaurenSchambach/ngwpc/nwm-coastal/ecflow_demo/ecf_home/coastal_hourly/cycle/h${HH}/regionalize_${CYCLE}.slurm.out" \
#     --wrap="cd /contrib/LaurenSchambach/ngwpc/nwm-rte && CYCLE_DT='${CYCLE_DT}' ./run_region_03S_standalone.sh"
./run_region_03S_standalone.sh
# ---- END LAUNCH ------------------------------------------------------------

if [ ! -f "${TROUTE_OUT_FILE}" ]; then
  echo "ERROR: expected t-route output missing: ${TROUTE_OUT_FILE}" >&2
  exit 1
fi
echo "regionalize OK: ${TROUTE_OUT_FILE}"

ecflow_client --complete   # tell ecFlow the task finished successfully
trap 0                     # clear all traps so ERROR() doesn't also fire on exit
exit 0