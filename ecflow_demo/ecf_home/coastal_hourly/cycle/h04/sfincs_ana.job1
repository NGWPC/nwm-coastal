set -e -u -x   # abort on error/unset var, print commands as executed

# Variables ecFlow substitutes at job-generation time (ecflow 5.6.0)
export ECF_NAME=/coastal_hourly/cycle/h04/sfincs_ana
export ECF_HOST=zhengtaocui-opertestbed-00023-mgmt
export ECF_PORT=39411
export ECF_PASS=sSkS7n4K
export ECF_TRYNO=1
export ECF_RID=$$              # no batch scheduler wrapping this job -> use the shell PID

export PATH="/contrib/software/ecflow/5.6.0/bin:${PATH}"

# Tell ecFlow this task has started
ecflow_client --init="${ECF_RID}"

# Error handler: report --abort to ecFlow instead of leaving the task
# stuck 'active' forever. Guarded against double-firing (ERR then EXIT).
_ERROR_HANDLED=0
ERROR() {
  local rc=$1
  set +e
  if [ "${_ERROR_HANDLED}" -eq 1 ]; then
    exit "${rc}"
  fi
  _ERROR_HANDLED=1
  trap - ERR EXIT
  ecflow_client --abort="task failed (rc=${rc})" || true
  exit "${rc}"
}
trap 'ERROR $?' ERR
trap 'ERROR $?' EXIT

YMD=20260809
HH=04
CYCLE=${YMD}${HH}
CYCLE_DT="${YMD:0:4}-${YMD:4:2}-${YMD:6:2} ${HH}:00:00"
PREV_CYCLE=$(date -u -d "-1 hour ${CYCLE_DT}" +"%Y%m%d%H")

# Bootstrap skip: mirrors gen_configs_ana.ecf's own check -- see that file
# for the full rationale on why this must be troute_ana_a's own PREV_CYCLE
# state (not a coastal-model hotstart/rst check). run_schism_download_ana
# reports complete either way (real run or its own skip), so this task's
# trigger alone can't tell the difference -- must re-check independently.
TROUTE_PREV_STATE_SAVE="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/region_ana_a_${PREV_CYCLE}/03S/state_save/troute"
if [ ! -f "${TROUTE_PREV_STATE_SAVE}" ]; then
  echo "No prior troute_ana_a state at ${TROUTE_PREV_STATE_SAVE} (bootstrap cycle) -- skipping sfincs_ana for ${CYCLE}"
  SKIP_COASTAL=1
else
  SKIP_COASTAL=0
fi

# A second %include <tail.h> here (one per skip branch, one at the true
# end) breaks ecflow's own job-generation preprocessing -- confirmed live:
# "Mismatched ecfmicro( include <tail.h>". Wrap the real
# work in a shell conditional instead, so there is only ever ONE
# %include <tail.h>, at the true end of the file.
if [ "${SKIP_COASTAL}" -eq 0 ]; then

CONFIG_FILE="/contrib/LaurenSchambach/ngwpc/run_coastal/sfincs_sims/cycles/ana_${CYCLE}/run.yaml"
[ -f "${CONFIG_FILE}" ] || { echo "ERROR: missing config: ${CONFIG_FILE}" >&2; exit 1; }

# SFINCS AnA: 3h T-3->T0, via gen_configs_ana.ecf's config (start_date=T-3,
# duration_hours=3, dtrstout=3600 so restarts actually get written,
# warm-started from PREV_CYCLE's own T-2 checkpoint if present -- true
# bootstrap cold-starts gracefully). Same checkpoint-mid-run rationale as
# schism_ana.ecf -- SFINCS can also checkpoint mid-run (single-process, no
# combine step needed unlike SCHISM's per-rank files -- see
# sfincs_output.f90's write_rst_file), so this ONE 3h run writes restarts
# at both the 1h mark (T-2, self-chains to next cycle's sfincs_ana via
# gen_configs_ana.ecf) and the 3h/final mark (T0, feeds sfincs_sr.ecf's
# warm start this same hour via gen_configs_sr.ecf).
#
# ---- LAUNCH (placeholder for future Slurm submission) --------------------
# Today: direct execution on this shared node.
/contrib/LaurenSchambach/ngwpc/nwm-coastal/nwm-coastal-cli run "${CONFIG_FILE}"
# ---- END LAUNCH ------------------------------------------------------------

fi

ecflow_client --complete   # tell ecFlow the task finished successfully
trap 0                     # clear all traps so ERROR() doesn't also fire on exit
exit 0