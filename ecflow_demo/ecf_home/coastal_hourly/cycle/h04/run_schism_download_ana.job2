set -e -u -x   # abort on error/unset var, print commands as executed

# Variables ecFlow substitutes at job-generation time (ecflow 5.6.0)
export ECF_NAME=/coastal_hourly/cycle/h04/run_schism_download_ana
export ECF_HOST=zhengtaocui-opertestbed-00023-mgmt
export ECF_PORT=39411
export ECF_PASS=UzY2YDkl
export ECF_TRYNO=2
export ECF_RID=$$              # no batch scheduler wrapping this job -> use the shell PID

export PATH="/contrib/software/ecflow/5.6.0/bin:${PATH}"

# Tell ecFlow this task has started
ecflow_client --init="${ECF_RID}"

# Error handler: report --abort to ecFlow instead of leaving the task
# stuck 'active' forever. Guarded against double-firing (ERR then EXIT).
_ERROR_HANDLED=0
ERROR() {
  local rc=$1
  set +e
  if [ "${_ERROR_HANDLED}" -eq 1 ]; then
    exit "${rc}"
  fi
  _ERROR_HANDLED=1
  trap - ERR EXIT
  ecflow_client --abort="task failed (rc=${rc})" || true
  exit "${rc}"
}
trap 'ERROR $?' ERR
trap 'ERROR $?' EXIT

YMD=20260809
HH=04
CYCLE=${YMD}${HH}
CYCLE_DT="${YMD:0:4}-${YMD:4:2}-${YMD:6:2} ${HH}:00:00"
PREV_CYCLE=$(date -u -d "-1 hour ${CYCLE_DT}" +"%Y%m%d%H")

# Bootstrap skip: mirrors gen_configs_ana.ecf's own check exactly -- see
# that file for the full rationale on why this must be troute_ana_a's own
# PREV_CYCLE state (not a coastal-model hotstart/rst check, which stays
# empty for two cycles and would make every cycle skip forever). If
# gen_configs_ana skipped (no run.yaml written), this task should skip
# too, not error. Re-checking here (not just inferring from CONFIG_FILE's
# absence) means a genuine missing-config bug on a non-bootstrap cycle
# still fails loudly below.
TROUTE_PREV_STATE_SAVE="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/region_ana_a_${PREV_CYCLE}/03S/state_save/troute"
if [ ! -f "${TROUTE_PREV_STATE_SAVE}" ]; then
  echo "No prior troute_ana_a state at ${TROUTE_PREV_STATE_SAVE} (bootstrap cycle) -- skipping download for ${CYCLE}"
  SKIP_COASTAL=1
else
  SKIP_COASTAL=0
fi

# A second %include <tail.h> here (one per skip branch, one at the true
# end) breaks ecflow's own job-generation preprocessing -- confirmed live:
# "Mismatched ecfmicro( include <tail.h>". Wrap the real
# work in a shell conditional instead, so there is only ever ONE
# %include <tail.h>, at the true end of the file.
if [ "${SKIP_COASTAL}" -eq 0 ]; then

CONFIG_FILE="/contrib/LaurenSchambach/ngwpc/run_coastal/schism_sims/cycles/ana_${CYCLE}/run.yaml"
[ -f "${CONFIG_FILE}" ] || { echo "ERROR: missing config: ${CONFIG_FILE}" >&2; exit 1; }

# AnA counterpart of run_schism_download_sr.ecf -- same STOFS boundary data,
# same race (SCHISM and SFINCS share raw_download_dir), same fix (download
# once, up front, serialized). schism_ana and sfincs_ana both trigger on
# this task's completion. See run_schism_download_sr.ecf for why this and
# the SR download never race each other despite sharing raw_download_dir.
#
# ---- LAUNCH (placeholder for future Slurm submission) --------------------
# Today: direct execution on this shared node.
/contrib/LaurenSchambach/ngwpc/nwm-coastal/nwm-coastal-cli run "${CONFIG_FILE}" --stop-after download
# ---- END LAUNCH ------------------------------------------------------------

fi

ecflow_client --complete   # tell ecFlow the task finished successfully
trap 0                     # clear all traps so ERROR() doesn't also fire on exit
exit 0