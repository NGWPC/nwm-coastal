set -e -u -x   # abort on error/unset var, print commands as executed

# Variables ecFlow substitutes at job-generation time (ecflow 5.6.0)
export ECF_NAME=/coastal_hourly/cycle/h04/troute_ana_b
export ECF_HOST=zhengtaocui-opertestbed-00023-mgmt
export ECF_PORT=39411
export ECF_PASS=zoVN9CdT
export ECF_TRYNO=1
export ECF_RID=$$              # no batch scheduler wrapping this job -> use the shell PID

export PATH="/contrib/software/ecflow/5.6.0/bin:${PATH}"

# Tell ecFlow this task has started
ecflow_client --init="${ECF_RID}"

# Error handler: report --abort to ecFlow instead of leaving the task
# stuck 'active' forever. Guarded against double-firing (ERR then EXIT).
_ERROR_HANDLED=0
ERROR() {
  local rc=$1
  set +e
  if [ "${_ERROR_HANDLED}" -eq 1 ]; then
    exit "${rc}"
  fi
  _ERROR_HANDLED=1
  trap - ERR EXIT
  ecflow_client --abort="task failed (rc=${rc})" || true
  exit "${rc}"
}
trap 'ERROR $?' ERR
trap 'ERROR $?' EXIT

YMD=20260809
HH=04
CYCLE=${YMD}${HH}
CYCLE_DT="${YMD:0:4}-${YMD:4:2}-${YMD:6:2} ${HH}:00:00"

# troute AnA-B: the 3-hour throwaway reprocessing (T-3 -> T0 relative to
# this cycle's own time). Never chained forward to a future cycle (that's
# troute_ana_a's job) -- this run exists purely to produce a T0 state for
# THIS cycle's SR troute run (troute_sr.ecf) and coastal AnA
# (coastal_ana_schism.ecf/coastal_ana_sfincs.ecf) to warm-start from. Loads
# from the SAME prior-cycle troute_ana_a save that troute_ana_a.ecf itself
# loads from (both branch off the same T-3 starting point) -- NOT from this
# hour's own troute_ana_a, which is a separate, independent 1h run. See
# troute_ana_a.ecf for the full rationale (two runs because troute can only
# checkpoint at wherever a run stops, not mid-run).
# IMPORTANT: relative adjustment must come BEFORE the timestamp -- see
# troute_ana_a.ecf for why "${CYCLE_DT} -1 hour" silently parses wrong in
# GNU date (confirmed live).
PREV_DT="-1 hour ${CYCLE_DT}"
PREV_CYCLE=$(date -u -d "${PREV_DT}" +"%Y%m%d%H")
# troute names its output file after the run's actual start_time, not the
# cycle time -- confirmed live from the realization config's own "time"
# block. This run's fcst_start is T-3 (CYCLE_DT-3h): -dt is CYCLE_DT (T0)
# and -lb 240 pulls it back to T-3 -- mswm's create_fcst_times() (ana_flag==1
# branch, unmodified upstream, do not edit) computes
# forcing_lookback = int(LookBack/60) - 1, so -lb 240 resolves to a 3h
# lookback (int(240/60)-1 == 3), not -lb 180 (int(180/60)-1 == 2, only a 2h
# lookback -- T-2, one hour short of what this run's loaded hotstart
# actually represents, T-3). See troute_ana_a.ecf for the identical -lb
# arithmetic and rationale. But troute's own restart/output timestamp is a
# further 1h before fcst_start by design (mswm ginputfunc.py: "troute must
# start 1h before [ngen] so that states can be transferred between runs",
# for realtime/non-hindcast forcing) -- confirmed live against the actual
# output filename (predicted T-3 == 11:00, real file was stamped 10:00).
# So the real stamp is T-4, not T-3.
STAMP=$(date -u -d "-4 hours ${CYCLE_DT}" +"%Y%m%d%H")00

RNAME="region_ana_b_${CYCLE}"
# netCDF outputs (troute_output_*.nc etc.) land in an Output/ subdirectory
# for AnA runs -- confirmed live across all 3 AnA test runs. state_save/
# stays directly under VPU/ (unaffected, confirmed separately).
TROUTE_OUT_FILE="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/${RNAME}/03S/Output/troute_output_${STAMP}.nc"
# HOST-side paths -- for the [ -f ... ] existence checks (outside docker).
SAVE_STATE_DIR="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/${RNAME}/03S/state_save"
LOAD_STATE_DIR="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/region_ana_a_${PREV_CYCLE}/03S/state_save"
# CONTAINER-side paths -- for the -ssd/-lsf flags, read INSIDE the
# container. See troute_ana_a.ecf for why these must differ from the HOST
# paths above (confirmed live: passing the HOST path silently no-ops the
# save).
SAVE_STATE_DIR_CONTAINER="/ngwpc/run_ngen/regionalization/${RNAME}/03S/state_save"
LOAD_STATE_DIR_CONTAINER="/ngwpc/run_ngen/regionalization/region_ana_a_${PREV_CYCLE}/03S/state_save"

export CYCLE_DT
export RNAME

# Bootstrap handling: see troute_ana_a.ecf -- same rationale, same source
# state (both A and B load from the same prior-cycle troute_ana_a save).
if [ -f "${LOAD_STATE_DIR}/troute" ]; then
  LOAD_STATE_ARGS="-lsf ${LOAD_STATE_DIR_CONTAINER}"
  echo "Warm-starting troute AnA-B from ${LOAD_STATE_DIR}"
else
  LOAD_STATE_ARGS=""
  echo "No prior troute_ana_a state at ${LOAD_STATE_DIR} -- cold-starting (expected only at bootstrap)"
fi
export LOAD_STATE_ARGS
export SAVE_STATE_DIR_CONTAINER

# ---- LAUNCH (placeholder for future Slurm submission) --------------------
# Today: direct execution on this shared node. -dt is this cycle's own
# CYCLE_DT (T0). -lb 240: gives a 3h lookback after mswm's own -1 (see
# STAMP comment above) -- this run's output lands at CYCLE_DT-3h (T-3),
# matching the T-3->T0 design (confirmed live: dt X, lb N minutes ->
# output stamped X-minus-(N/60-1)-hours). Also matches exactly what this
# run's loaded hotstart represents: PREV_CYCLE's own troute_ana_a save is
# valid at PREV_CYCLE's own T-2, which equals THIS cycle's own T-3 --
# -lb 180 (2h lookback) previously left a 1h gap between what the loaded
# state represented (T-3) and what this run's own fcst_start declared
# (T-2), which -lb 240 now closes. Same caveats as troute_ana_a.ecf:
# -lsf/-ss/-ssd mechanics confirmed real end to end.
bash -c '
  set -euo pipefail
  cd "/contrib/LaurenSchambach/ngwpc/nwm-rte"
  source config.bashrc
  source run.sh
  TEST_VPU="vpu_03S"
  TEST_FORM_ASSIGN_VPU="${INSTALLED_REGIONALIZATION_RESULTS}/${TEST_VPU}/formulation_assignment.csv"
  TEST_CAT_GRP_VPU="${INSTALLED_REGIONALIZATION_RESULTS}/${TEST_VPU}/catchment_groups.csv"
  docker_run python -um "ngen_rte.run_regionalization_standalone" -n 12 -faf "${TEST_FORM_ASSIGN_VPU}" -cgf "${TEST_CAT_GRP_VPU}" -fconfig "standard_ana" -dt "${CYCLE_DT}" -lb 240 -rname "${RNAME}" -v "03S" -outfmt NetCDF -ss -ssd "${SAVE_STATE_DIR_CONTAINER}" ${LOAD_STATE_ARGS}
' "/contrib/LaurenSchambach/ngwpc/nwm-rte/run.sh"
# ---- END LAUNCH ------------------------------------------------------------

if [ ! -f "${TROUTE_OUT_FILE}" ]; then
  echo "ERROR: expected t-route output missing: ${TROUTE_OUT_FILE}" >&2
  exit 1
fi
if [ ! -f "${SAVE_STATE_DIR}/troute" ]; then
  echo "ERROR: expected troute_ana_b state save missing: ${SAVE_STATE_DIR}/troute" >&2
  exit 1
fi
echo "troute AnA-B OK: ${TROUTE_OUT_FILE}, ${SAVE_STATE_DIR}/troute"

ecflow_client --complete   # tell ecFlow the task finished successfully
trap 0                     # clear all traps so ERROR() doesn't also fire on exit
exit 0