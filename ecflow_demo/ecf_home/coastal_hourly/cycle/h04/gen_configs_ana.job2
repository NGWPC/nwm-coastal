set -e -u -x   # abort on error/unset var, print commands as executed

# Variables ecFlow substitutes at job-generation time (ecflow 5.6.0)
export ECF_NAME=/coastal_hourly/cycle/h04/gen_configs_ana
export ECF_HOST=zhengtaocui-opertestbed-00023-mgmt
export ECF_PORT=39411
export ECF_PASS=SrFlLQFc
export ECF_TRYNO=2
export ECF_RID=$$              # no batch scheduler wrapping this job -> use the shell PID

export PATH="/contrib/software/ecflow/5.6.0/bin:${PATH}"

# Tell ecFlow this task has started
ecflow_client --init="${ECF_RID}"

# Error handler: report --abort to ecFlow instead of leaving the task
# stuck 'active' forever. Guarded against double-firing (ERR then EXIT).
_ERROR_HANDLED=0
ERROR() {
  local rc=$1
  set +e
  if [ "${_ERROR_HANDLED}" -eq 1 ]; then
    exit "${rc}"
  fi
  _ERROR_HANDLED=1
  trap - ERR EXIT
  ecflow_client --abort="task failed (rc=${rc})" || true
  exit "${rc}"
}
trap 'ERROR $?' ERR
trap 'ERROR $?' EXIT

YMD=20260809
HH=04
CYCLE=${YMD}${HH}
CYCLE_DT="${YMD:0:4}-${YMD:4:2}-${YMD:6:2} ${HH}:00:00"
# IMPORTANT: relative adjustment must come BEFORE the timestamp -- see
# troute_ana_a.ecf for why "${CYCLE_DT} -1 hour" silently parses wrong in
# GNU date (confirmed live: evaluates to +2h, not -1h).
PREV_CYCLE=$(date -u -d "-1 hour ${CYCLE_DT}" +"%Y%m%d%H")
# T-3 relative to THIS cycle == T-2 relative to PREV_CYCLE -- the exact real
# time PREV_CYCLE's own schism_ana/sfincs_ana wrote their 1h-mark checkpoint
# at. See troute_ana_a.ecf for the same PREV_CYCLE derivation rationale
# (date arithmetic, not string slicing, so day/month/year rollover is free).
T_MINUS_3_STAMP=$(date -u -d "-3 hours ${CYCLE_DT}" +"%Y%m%d.%H0000")
# ngen_forcing_ana's output is named after the raw cycle time (run_coastal.py
# passes -dt straight through as RefcstBDateProc, unshifted -- see the
# run_coastal.py AnA windowing fix).
STAMP=${CYCLE}00
# troute_ana_b's output, by contrast, is named after its actual restart
# timestamp, which is a further 1h before its own fcst_start (T-4, not
# T-3) -- see troute_ana_b.ecf for the mswm rationale and live
# confirmation. NOT the same value as T_MINUS_3_STAMP above (that one is
# for SCHISM/SFINCS's own self-chained checkpoint naming, unrelated to
# troute's mswm-specific shift).
TROUTE_STAMP=$(date -u -d "-4 hours ${CYCLE_DT}" +"%Y%m%d%H")00

FORCING_FILE="/contrib/LaurenSchambach/ngwpc/run_ngen/data/scratch/standard_ana_coastal/CONUS_${STAMP}.nc"
# troute's netCDF outputs land in an Output/ subdirectory for AnA runs --
# confirmed live across all 3 AnA test runs (see troute_ana_a.ecf/
# troute_ana_b.ecf).
TROUTE_FILE="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/region_ana_b_${CYCLE}/03S/Output/troute_output_${TROUTE_STAMP}.nc"

for f in "${FORCING_FILE}" "${TROUTE_FILE}"; do
  [ -f "$f" ] || { echo "ERROR: upstream file missing: $f" >&2; exit 1; }
done

SCHISM_CYCLE_DIR="/contrib/LaurenSchambach/ngwpc/run_coastal/schism_sims/cycles/ana_${CYCLE}"
SFINCS_CYCLE_DIR="/contrib/LaurenSchambach/ngwpc/run_coastal/sfincs_sims/cycles/ana_${CYCLE}"

# Self-chain warm start: PREV_CYCLE's own schism_ana/sfincs_ana run wrote a
# checkpoint at T-2 (relative to PREV_CYCLE) == T-3 (relative to THIS
# cycle) == this run's own start_date.
#
# SCHISM: hotstart_it=<iteration>.nc -- iteration is a timestep count, not
# derivable without parsing param.nml, but combine_hotstart() writes
# hourly, so the SMALLEST iteration present is always the first/T-2
# checkpoint -- discover it by numeric sort.
PREV_SCHISM_ANA_OUTPUTS_DIR="/contrib/LaurenSchambach/ngwpc/run_coastal/schism_sims/cycles/ana_${PREV_CYCLE}/run/outputs"
SCHISM_HOT_START_FILE=""
if [ -d "${PREV_SCHISM_ANA_OUTPUTS_DIR}" ]; then
  SCHISM_HOT_START_FILE=$(
    for f in "${PREV_SCHISM_ANA_OUTPUTS_DIR}"/hotstart_it=*.nc; do
      [ -e "$f" ] || continue
      n=$(echo "$f" | sed -E 's/.*hotstart_it=([0-9]+)\.nc$/\1/')
      echo "${n} ${f}"
    done | sort -n | head -1 | awk '{print $2}'
  )
fi

# SFINCS: sfincs.<YYYYMMDD.HHMMSS>.rst, name computed directly (see
# T_MINUS_3_STAMP above) -- no globbing needed.
PREV_SFINCS_ANA_RUN_DIR="/contrib/LaurenSchambach/ngwpc/run_coastal/sfincs_sims/cycles/ana_${PREV_CYCLE}/run"
SFINCS_RST_FILE="${PREV_SFINCS_ANA_RUN_DIR}/sfincs.${T_MINUS_3_STAMP}.rst"

# Bootstrap skip: the true first cycle in the suite's history has no
# troute_ana_a state from PREV_CYCLE either (troute itself is at its own
# bootstrap, no -lsf to load). Confirmed live that troute's T-3 sample is
# NOT an echo of loaded state when a hotstart IS available (real flow
# values evolve smoothly hour to hour, see troute_ana_a.ecf/troute_ana_b.ecf
# -lb fix notes) -- but a truly cold-started troute_ana_b (no prior state
# at all) still has genuine cold-start spin-up in its first simulated
# hour(s), a real routing-model concern distinct from that echo theory.
# Rather than cold-starting SCHISM/SFINCS against that degraded first hour,
# skip the whole coastal-model chain for this one cycle: run only
# ngen_forcing_ana/troute_ana_a/troute_ana_b (unaffected, already triggered
# independently of this task) so troute gets a full cycle of real history,
# then let coastal models cold-start cleanly next cycle once troute_ana_b
# itself has a real hotstart to load and produces a genuine T-3-to-T0
# window.
#
# IMPORTANT: this check must be troute_ana_a's own PREV_CYCLE state (NOT
# SCHISM_HOT_START_FILE/SFINCS_RST_FILE above) -- those stay empty for
# TWO cycles (the skipped bootstrap cycle produces no coastal-model output
# at all), which would make every cycle skip forever. troute_ana_a runs
# unconditionally every cycle (including the bootstrap one), so by the
# very next cycle it already has real PREV_CYCLE state regardless of
# whether coastal models have ever run -- making this check self-limiting
# to exactly the one true bootstrap cycle, same LOAD_STATE_DIR path
# troute_ana_a.ecf itself already checks.
TROUTE_PREV_STATE_SAVE="/contrib/LaurenSchambach/ngwpc/run_ngen/regionalization/region_ana_a_${PREV_CYCLE}/03S/state_save/troute"
if [ ! -f "${TROUTE_PREV_STATE_SAVE}" ]; then
  echo "No prior troute_ana_a state at ${TROUTE_PREV_STATE_SAVE} (bootstrap cycle) -- skipping coastal-model chain for ${CYCLE}"
  SKIP_COASTAL=1
else
  SKIP_COASTAL=0
fi

# A second %include <tail.h> here (one per skip branch, one at the true
# end) breaks ecflow's own job-generation preprocessing -- confirmed live:
# "Mismatched ecfmicro( include <tail.h>" -- ecflow's %
# micro-substitution scanner doesn't tolerate %include appearing twice in
# one script. Wrap the real work in a shell conditional instead, so there
# is only ever ONE %include <tail.h>, at the true end of the file.
if [ "${SKIP_COASTAL}" -eq 0 ]; then

# ---- LAUNCH (placeholder for future Slurm submission) --------------------
# Today: direct execution (sub-second; unlikely to ever need Slurm).
/contrib/LaurenSchambach/ngwpc/nwm-coastal/nwm-coastal-py /contrib/LaurenSchambach/ngwpc/nwm-coastal/ecflow_demo/bin/gen_cycle_config.py \
  --model schism \
  --run-type ana \
  --base-yaml "/contrib/LaurenSchambach/ngwpc/run_coastal/schism_sims/run.yaml" \
  --cycle "${CYCLE}" \
  --start-date "${CYCLE_DT}" \
  --forecast-meteo-file "${FORCING_FILE}" \
  --troute-file "${TROUTE_FILE}" \
  --cycle-dir "${SCHISM_CYCLE_DIR}" \
  ${SCHISM_HOT_START_FILE:+--hot-start-file "${SCHISM_HOT_START_FILE}"}

/contrib/LaurenSchambach/ngwpc/nwm-coastal/nwm-coastal-py /contrib/LaurenSchambach/ngwpc/nwm-coastal/ecflow_demo/bin/gen_cycle_config.py \
  --model sfincs \
  --run-type ana \
  --base-yaml "/contrib/LaurenSchambach/ngwpc/run_coastal/sfincs_sims/run.yaml" \
  --cycle "${CYCLE}" \
  --start-date "${CYCLE_DT}" \
  --forecast-meteo-file "${FORCING_FILE}" \
  --troute-file "${TROUTE_FILE}" \
  --cycle-dir "${SFINCS_CYCLE_DIR}" \
  --sfincs-rst-file "${SFINCS_RST_FILE}"
# ---- END LAUNCH ------------------------------------------------------------

for f in "${SCHISM_CYCLE_DIR}/run.yaml" "${SFINCS_CYCLE_DIR}/run.yaml"; do
  [ -s "$f" ] || { echo "ERROR: generated config missing/empty: $f" >&2; exit 1; }
done

fi

ecflow_client --complete   # tell ecFlow the task finished successfully
trap 0                     # clear all traps so ERROR() doesn't also fire on exit
exit 0